# Verifica se o gum está instalado
if ! command -v gum &> /dev/null; then
    echo "Você precisa instalar o gum para usar este script."
    exit 1
fi

# Interface de escolha da ação a ser realizada pelo usuário
OPTIONS=$(gum choose \
        "Atualizar Flatpak" \
        "Remover Flatpak" \
        "Instalar Flatpak" \
        "Matar processos")


#########################
# Função de atualização #
#########################
update(){

    # Verifica quais pacote seram atualializados
    PACKAGES=$(gum spin --title "Atualizando Flatpak" -- flatpak update)
    PACKAGES_LIST="$(flatpak update | awk '/^ [1-9][0-9]?\./ {print $2}')"

    # Se não houver pacotes para atualizar, sai
    [[ $PACKAGES =~ "Nothing to update" ]] && \
    echo "Não há pacotes para atualizar" && exit 0

    # Lista os pacotes
    gum pager <<< "$PACKAGES_LIST"

    # Executa a atualização
    if gum confirm "Deseja atualizar os pacotes?"; then
        if gum spin --title "Atualizando Flatpak" -- flatpak update -y; then
            echo "Pacotes atualizados com sucesso!"
            if gum confirm "Deseja limpar pacotes não utilizados?"; then
                gum spin --title "Limpando Flatpak" -- flatpak uninstall --unused -y
                echo "Pacotes não utilizados removidos com sucesso!"
            else
                echo "Operação cancelada pelo usuário"
                exit 1  
            fi
        else
            echo "Erro ao atualizar pacotes"
            exit 1
        fi
    else
        echo "Operação cancelada pelo usuário"
        exit 1
    fi
}

#####################
# Função de remoção #
#####################
remove (){
   
    # Lista os aplicativos instalados 
    APPLICATIONS=$(flatpak list --app --columns=name,application |
        awk -F'\t' '{printf "%-40s %s\n", $1, $2}' |
        gum filter --no-limit |
        awk '{print $NF}')

    # Verifica se o usuário selecionou algum aplicativo
    [[ -z $APPLICATIONS ]] && echo "Nenhum aplicativo para remover" && exit 0
    
    # Pergunta ao usuário se deseja remover o aplicativo
    if gum confirm "Deseja remover o aplicativo $APPLICATIONS?"; then
        if gum spin --title "Removendo Flatpak" -- flatpak uninstall -y $APPLICATIONS; then
            echo "Aplicativo removido com sucesso!"
            if gum confirm "Deseja remover os dados do aplicativo?"; then
                gum spin --title "Removendo Flatpak" -- flatpak uninstall -y --delete-data $APPLICATIONS
                echo "Dados removidos com sucesso!"
            else
                echo "Operação cancelada pelo usuário"
                exit 1
            fi
        else
            echo "Erro ao remover aplicativo"
            exit 1
        fi
    else
        echo "Operação cancelada pelo usuário"
        exit 1
    fi
}

########################
# Função de instalação #
########################
install(){
    
    APPLICATIONS_INSTALL=$(gum input --placeholder "Digite o nome do aplicativo que deseja instalar")

    # Verifica se o usuário digitou algo
    if [ -z $APPLICATIONS_INSTALL ]; then
        echo "Nenhum aplicativo informado"
        exit 0
    fi
    
    # Pega o nome do aplicativo que o usuário vai digita e passa para a variavel 
    APP_INSTALL=$( gum spin --title "Buscando Flatpak" -- \
        flatpak search "$APPLICATIONS_INSTALL" --columns=name,application |
        awk -F'\t' '{printf "%-35s|%s\n", $1, $2}' |
        gum filter --no-limit |
        cut -d'|' -f2)
 
    # Verifica se o usuário selecionou algum aplicativo
    if [ -z $APP_INSTALL ]; then
        echo "Nenhum aplicativo encontrado"
        exit 1
    fi

    # Verifica se o aplicativo já está instalado
    if flatpak list --app --columns=application | grep $APP_INSTALL; then
        echo "Aplicativo já instalado"
        exit 1
    fi
    
    if gum confirm "Deseja instalar o aplicativo $APP_INSTALL?"; then
        if gum spin --title "Instalando Flatpak" -- flatpak install -y $APP_INSTALL; then
            echo "Aplicativo instalado com sucesso!"
        else
            echo "Erro ao instalar aplicativo"
            exit 1
        fi
    else
        echo "Operação cancelada pelo usuário"
        exit 1
    fi
}

##################
# Função killall #
##################
kill_process(){

    # Lista os aplicativos que estão rodando
    APP_KILL=$(flatpak ps --columns=application,instance |
        awk -F'\t' '{printf "%-40s %s\n", $1, $2}' |
        gum filter --no-limit |
        awk '{print $NF}')

    # Verifica se o usuário selecionou algum aplicativo
    if [ -z $APP_KILL ]; then
        echo "Nenhum aplicativo encontrado"
        exit 1
    fi

    # Pergunta ao usuário se deseja matar o processo
    if gum confirm "Deseja matar o(s) processo(s)?"; then
        if gum spin --title "Matando processo Flatpak" -- echo $APP_KILL | xargs -n 1 flatpak kill; then
            echo "Processo morto com sucesso!"
        else
            echo "Erro ao matar processo"
            exit 1
        fi
    else
        echo "Operação cancelada pelo usuário"
        exit 1
    fi
}

#########################
# Script começa no case #
#########################
case $OPTIONS in
    "Atualizar Flatpak")
       update 
       ;;
    "Remover Flatpak")
        remove
        ;;
    "Instalar Flatpak")
        install
        ;;
    "Matar processos")
        kill_process
        ;;
esac